# Domain / public URLs
PUBLIC_DOMAIN=restream.medialive.ru
NEXT_PUBLIC_OBS_SERVER_URL=rtmp://restream.medialive.ru/live
NEXT_PUBLIC_HLS_BASE_URL=https://restream.medialive.ru/srs/live

# Backend database
# Leave DATABASE_URL empty to use SQLite via RESTREAM_DB_PATH.
RESTREAM_DB_PATH=/opt/restream/restream.db
DATABASE_URL=

# PostgreSQL example:
# DATABASE_URL=postgresql://restream:change_me@postgres:5432/restream
POSTGRES_DB=restream
POSTGRES_USER=restream
POSTGRES_PASSWORD=change_me

# Backend runtime
RESTREAM_BACKUP_DIR=/data/backups
RESTREAM_LOG_DIR=/data/logs
RESTREAM_AUTH_SESSION_DAYS=7
RESTREAM_DEFAULT_CLIENT_PLAN=free
RESTREAM_DEFAULT_MAX_DESTINATIONS=1
RESTREAM_ADMIN_MAX_DESTINATIONS=99
RESTREAM_ADMIN_USERNAME=admin
RESTREAM_ADMIN_PASSWORD=change_me_on_first_deploy
RESTREAM_ADMIN_EMAIL=info@medialive.ru
RESTREAM_SRS_WEBHOOK_SECRET=change_me_srs_webhook_secret
# Comma-separated source IPs allowed to call /on_publish and /on_unpublish without a token.
RESTREAM_SRS_TRUSTED_IPS=127.0.0.1,::1
RESTREAM_CORS_ORIGINS=https://restream.medialive.ru,http://localhost:3000
RESTREAM_COOKIE_NAME=restream_session
RESTREAM_COOKIE_SECURE=true
RESTREAM_PUBLIC_URL=https://restream.medialive.ru
RESTREAM_SMTP_HOST=
RESTREAM_SMTP_PORT=587
RESTREAM_SMTP_USERNAME=
RESTREAM_SMTP_PASSWORD=
RESTREAM_SMTP_FROM=info@medialive.ru
RESTREAM_SMTP_TLS=true
# Use port 465 with SSL if outbound SMTP port 587 is blocked by the hoster:
# RESTREAM_SMTP_PORT=465
# RESTREAM_SMTP_SSL=true
# RESTREAM_SMTP_TLS=false
SRS_INPUT_URL_TEMPLATE=rtmp://127.0.0.1/live/{stream_key}
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
RESTREAM_FFMPEG_MAX_RESTARTS=5
RESTREAM_FFMPEG_RESTART_DELAY_SECONDS=3
# RTMP network read/write timeout in microseconds (15000000 = 15s)
RESTREAM_FFMPEG_RW_TIMEOUT_US=15000000
# Kill hung FFmpeg if progress stops for this many seconds (0 = disable)
RESTREAM_FFMPEG_STALL_TIMEOUT_SECONDS=45
RESTREAM_FFMPEG_STALL_GRACE_SECONDS=30
# On backend restart: adopt = reattach orphan FFmpeg; kill = terminate orphans
RESTREAM_FFMPEG_ORPHAN_POLICY=adopt
RESTREAM_STATE_DIR=/opt/restream/state

# Frontend runtime
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_API_BASE_URL=
