# Domain / public URLs
PUBLIC_DOMAIN=restream.medialive.ru
NEXT_PUBLIC_OBS_SERVER_URL=rtmp://restream.medialive.ru/live
NEXT_PUBLIC_HLS_BASE_URL=https://restream.medialive.ru/srs/live

# Backend database
# SQLite (host default): leave DATABASE_URL empty
RESTREAM_DB_PATH=/opt/restream/restream.db
DATABASE_URL=

# PostgreSQL / Docker Compose (required when using compose_up.sh):
# DATABASE_URL=postgresql://restream:REPLACE_WITH_STRONG_DB_PASSWORD@postgres:5432/restream
POSTGRES_DB=restream
POSTGRES_USER=restream
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# Backend runtime paths
# Host systemd:
RESTREAM_BACKUP_DIR=/opt/restream/backups
RESTREAM_LOG_DIR=/opt/restream/logs
RESTREAM_STATE_DIR=/opt/restream/state
# Docker Compose overrides these to /data/* via docker-compose.yml

RESTREAM_AUTH_SESSION_DAYS=7
RESTREAM_DEFAULT_CLIENT_PLAN=free
RESTREAM_DEFAULT_MAX_DESTINATIONS=1
RESTREAM_ADMIN_MAX_DESTINATIONS=99
RESTREAM_ADMIN_USERNAME=admin
RESTREAM_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
RESTREAM_ADMIN_EMAIL=info@medialive.ru

# REQUIRED for production. Must match SRS rendered config. Never use change_me*.
RESTREAM_SRS_WEBHOOK_SECRET=REPLACE_WITH_STRONG_SRS_WEBHOOK_SECRET
# Informational only — secret is always required. Never a bypass.
RESTREAM_SRS_TRUSTED_IPS=127.0.0.1,::1
# Docker: backend:8000   Host/systemd: 127.0.0.1:8000
RESTREAM_SRS_BACKEND_HOOK=127.0.0.1:8000
# Local/dev only. Production must keep false.
RESTREAM_ALLOW_INSECURE_DEFAULTS=false

RESTREAM_CORS_ORIGINS=https://restream.medialive.ru,http://localhost:3000
RESTREAM_COOKIE_NAME=restream_session
RESTREAM_COOKIE_SECURE=true
RESTREAM_PUBLIC_URL=https://restream.medialive.ru
# Trust X-Forwarded-For for auth rate limits only from these proxy peers
RESTREAM_AUTH_TRUSTED_PROXIES=127.0.0.1,::1

RESTREAM_SMTP_HOST=
RESTREAM_SMTP_PORT=587
RESTREAM_SMTP_USERNAME=
RESTREAM_SMTP_PASSWORD=
RESTREAM_SMTP_FROM=info@medialive.ru
RESTREAM_SMTP_TLS=true
# RESTREAM_SMTP_PORT=465
# RESTREAM_SMTP_SSL=true
# RESTREAM_SMTP_TLS=false

SRS_INPUT_URL_TEMPLATE=rtmp://127.0.0.1/live/{stream_key}
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Per-destination worker restart policy (rolling window + exponential backoff)
RESTREAM_FFMPEG_MAX_RESTARTS=5
RESTREAM_FFMPEG_RESTART_WINDOW_SECONDS=300
RESTREAM_FFMPEG_RESTART_BACKOFF_BASE_SECONDS=2
RESTREAM_FFMPEG_RESTART_BACKOFF_MAX_SECONDS=60
RESTREAM_FFMPEG_STABLE_RESET_SECONDS=60
RESTREAM_FFMPEG_RESTART_DELAY_SECONDS=2

# Stall watchdog (conservative; requires prior progress then freeze)
RESTREAM_FFMPEG_RW_TIMEOUT_US=15000000
RESTREAM_FFMPEG_STALL_TIMEOUT_SECONDS=120
RESTREAM_FFMPEG_STALL_GRACE_SECONDS=60
RESTREAM_FFMPEG_STALL_POLL_SECONDS=5
RESTREAM_FFMPEG_STALL_MIN_SAMPLES=3
RESTREAM_FFMPEG_ORPHAN_POLICY=adopt

# Auth rate limits
RESTREAM_AUTH_RATE_LIMIT=20
RESTREAM_AUTH_RATE_WINDOW_SECONDS=60
RESTREAM_ALLOW_PLAINTEXT_PASSWORDS=false

# Optional local bind (defaults: 127.0.0.1:8000). Prefer nginx in front.
# RESTREAM_BIND_HOST=127.0.0.1
# RESTREAM_BIND_PORT=8000

# PostgreSQL integration tests (real Postgres, not SQLite):
#   ./deploy/scripts/run_postgres_tests.sh
# Or manually:
#   docker compose -f docker-compose.yml -f docker-compose.test.yml up -d postgres
#   RESTREAM_TEST_DATABASE_URL=postgresql://restream:restream_test_password@127.0.0.1:55432/restream_test \
#     pytest -q tests/test_postgres_integration.py
# RESTREAM_TEST_DATABASE_URL=postgresql://restream:restream_test_password@127.0.0.1:55432/restream_test

# Frontend runtime
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_API_BASE_URL=
