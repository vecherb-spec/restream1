[Unit]
Description=Restream FastAPI backend
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/restream
EnvironmentFile=-/opt/restream/.env
Environment=PATH=/opt/restream/.venv/bin:/opt/restream/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/bin/bash -lc 'if [[ -x /opt/restream/.venv/bin/uvicorn ]]; then exec /opt/restream/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000; else exec /opt/restream/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000; fi'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
