[Unit]
Description=Restream Next.js frontend
After=network.target restream-backend.service

[Service]
Type=simple
User=restream
Group=restream
WorkingDirectory=/opt/restream/frontend
EnvironmentFile=-/opt/restream/.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=PORT=3000
# Bind locally; expose publicly via nginx only.
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
